" Generated by tools/build.mjs from registry.json. Do not edit by hand.
autocmd BufRead,BufNewFile *.machen,*.mach,Machendatei,Machenfile,machenfile setfiletype machen
autocmd BufRead,BufNewFile *.debil,*.dbl,*.mdbl setfiletype markdebil
autocmd BufRead,BufNewFile *.r3k,*.r3000,*.rzk setfiletype r3000
autocmd BufRead,BufNewFile *.szajs,*.sx setfiletype szajs_script
autocmd BufRead,BufNewFile *.szmelc,*.sernik,Szmelc.inc,Szmelcfile,szmelc.inc setfiletype szmelc_inc
autocmd BufRead,BufNewFile *.vc,*.vic,*.vice setfiletype vibe_c
" .inc is shared with many languages: only claim it when the signature is present.
autocmd BufRead,BufNewFile *.inc if getline(1) =~# '^%szmelc\.inc\>' | setlocal filetype=szmelc_inc | endif
autocmd BufRead * if getline(1) =~# '^#!.*\<szajs\>' | setfiletype szajs_script | endif
autocmd BufRead * if getline(1) =~# '^#!.*\<\(r3k\|rozkurwator\)\>' | setfiletype r3000 | endif
