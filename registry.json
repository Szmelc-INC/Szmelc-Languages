{
  "$comment": "Single source of truth for the Szmelc language family. tools/check.mjs validates every other file against it.",
  "version": "1.0.0",
  "languages": [
    {
      "name": "Machen",
      "slug": "machen",
      "type": "programming",
      "color": "#1f8a8a",
      "tagline": "German-flavoured build system: ziel, setze, mach.",
      "extensions": [
        ".machen",
        ".mach"
      ],
      "filenames": [
        "Machendatei",
        "Machenfile",
        "machenfile"
      ],
      "interpreters": [
        "machen"
      ],
      "aliases": [
        "machenfile"
      ],
      "scope": "source.machen",
      "ace_mode": "makefile",
      "mime": "text/x-machen",
      "signature": "^#!\\s*machen\\b",
      "interim": "Makefile",
      "comment": "#",
      "keywords": [
        "ziel",
        "setze",
        "mach",
        "sag",
        "fehler",
        "wenn",
        "sonst",
        "ende",
        "fuer",
        "in",
        "importiere",
        "standard"
      ],
      "constants": []
    },
    {
      "name": "Markdebil",
      "slug": "markdebil",
      "type": "prose",
      "color": "#c0c0c0",
      "tagline": "Markdown for people who shout: !!!SHOUTS!!!, >:( rants, ?? questions.",
      "extensions": [
        ".debil",
        ".dbl",
        ".mdbl"
      ],
      "filenames": [],
      "interpreters": [],
      "aliases": [
        "debil"
      ],
      "scope": "text.markdebil",
      "ace_mode": "markdown",
      "wrap": true,
      "mime": "text/x-markdebil",
      "signature": "^\\+\\+\\+\\s*markdebil\\b",
      "interim": "Markdown",
      "comment": "%%",
      "keywords": [],
      "constants": []
    },
